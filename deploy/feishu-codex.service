# Bridge: Feishu long connection, intent routing, group agent, task queue and Runner API.
# Copy to /etc/systemd/system/, adjust paths, then: systemctl daemon-reload && systemctl enable --now feishu-codex
[Unit]
Description=Feishu Codex Bridge
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/feishu-codex
Environment=FEISHU_CODEX_CONFIG=/opt/feishu-codex/config.json
ExecStart=/usr/bin/node /opt/feishu-codex/dist/src/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
