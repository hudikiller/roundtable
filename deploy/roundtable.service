# Bridge: Feishu long connection, intent routing, group agent, task queue and Runner API.
# Copy to /etc/systemd/system/, adjust paths, then: systemctl daemon-reload && systemctl enable --now roundtable
[Unit]
Description=Roundtable Bridge
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/roundtable
Environment=FEISHU_CODEX_CONFIG=/opt/roundtable/config.json
ExecStart=/usr/bin/node /opt/roundtable/dist/src/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
